{
    "name": "@chektek/streamdeck-harness",
    "version": "0.1.0",
    "description": "Headless test harness for Stream Deck plugins.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ChekTek/streamdeck-harness.git"
    },
    "type": "module",
    "bin": {
        "sdtest": "dist/cli/main.js"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=24"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "watch": "tsc -p tsconfig.json --watch",
        "lint": "eslint --max-warnings 0 && oxlint",
        "lint:fix": "eslint . --fix && prettier . --write",
        "browser": "node dist/cli/main.js install-browser",
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "prepublishOnly": "pnpm clean && pnpm build"
    },
    "packageManager": "pnpm@11.9.0",
    "prettier": "@elgato/prettier-config",
    "dependencies": {
        "playwright": "^1.49.0",
        "sax": "^1.4.1",
        "ws": "^8.18.0",
        "yaml": "^2.6.0"
    },
    "devDependencies": {
        "@elgato/eslint-config": "^0.3.2",
        "@elgato/prettier-config": "^0.3.3",
        "@oxlint/plugins": "1.79.0",
        "@tsconfig/node24": "^24.0.6",
        "@types/node": "~24.19.2",
        "@types/sax": "^1.2.7",
        "@types/ws": "^8.5.13",
        "eslint": "^9.39.5",
        "oxlint": "1.79.0",
        "typescript": "^5.7.0"
    }
}
